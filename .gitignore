# Runtime / données locales
users_db.json
/etc/labosurf/users_db.json
config.local.json

# Secrets
.env
*.key
*.pem
labosurf_admin.key
.labosurf_admin.key

# Clés publiques de vérification de licence (non secrètes, trackées)
!release/license_pub.key
!engines/udp/labosurf_pub.key

# Temporaires / logs / sauvegardes
*.tmp
*.log
*.backup
*.backup2
*.before-*
*.before-labosurf

# Binaires locaux
labosurf-android-arm64
labosurf-linux-arm64
labosurf-linux-amd64
dist/

# Binaires locaux compilés sans extension (go build -o ...)
# Attention : un espace en tête de ligne fait partie du motif en syntaxe
# .gitignore (seuls les espaces EN FIN de ligne sont ignorés, sauf s'ils
# sont échappés) — ces 6 règles étaient donc inactives (jamais matchées).
/labosurf
/engine
/labosurf-mgr.exe
/engines/udp/labosurf
/engines/udp/labosurf-server
/engines/udp/engine
/engines/udp/coverage
/coverage.out

# Binaires / tests compilés (Windows ou produites par go test)
*.exe
*.test

# Configuration locale contenant potentiellement des secrets
engines/udp/config.json

# Données runtime locales / identifiants / tokens
engines/udp/runtime/

# Base de licences locale / tokens
engines/udp/licenses.json

# Binaire racine local (ne jamais committer)
/labosurf

# Rapports d'audit / rapports temporaires — ne pas déployer
AUDIT_*.md
RAPPORT_*.md
*_REPORT.md
FILES_TO_DELETE.md
UNUSED_FILES.md
